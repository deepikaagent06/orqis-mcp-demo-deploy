# orqis-mcp-demo-deploy — this image is fully self-contained and does NOT
# read a .env file for its database connection: entrypoint.sh always
# generates DATABASE_URL internally, pointed at the Postgres instance
# running inside this same container (127.0.0.1). There is no external
# DATABASE_URL to configure, and none is honored if supplied.
#
# The variables below are all optional overrides baked in as image defaults
# (see Dockerfile ENV) -- listed here for reference only. You normally do
# not need to set any of these; they exist so `docker run -e ...` can adjust
# them without rebuilding the image.

# The tool argument value Pullak (or anyone testing this demo) should pass
# as tenant_id to all five MCP tools. Must match what seed_demo.py seeded.
DEMO_TENANT_ID=demo-tenant-pullak

# MCP transport (do not change for the Glama deployment -- must stay
# streamable-http so the /mcp HTTP endpoint and /health both work).
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8001

# In-container-only demo Postgres credentials. Not a secret worth
# protecting: this Postgres is bound to 127.0.0.1 inside the container's own
# network namespace and is never reachable from outside it, so these values
# are safe to keep as fixed, documented defaults rather than treating them
# as production credentials.
DEMO_PG_USER=orqis_demo
DEMO_PG_PASSWORD=orqis_demo_local_only
DEMO_PG_DB=orqis_mcp_demo
