# orqis-mcp is NOT standalone: it imports an existing ORQIS backend
# checkout's `database`, `middleware`, and `services` packages in-process
# (see src/orqis_mcp/server.py and README.md's "Dependency on ORQIS"
# section). Point this at that checkout's backend/ directory.
#
# That ORQIS/backend directory must itself already be runnable: its own
# Python dependencies installed in this same environment, and its own
# .env configured with a working DATABASE_URL pointing at a reachable,
# migrated Postgres database. orqis-mcp reads that backend's config as-is;
# it does not define a separate DATABASE_URL of its own.
ORQIS_BACKEND_PATH=/absolute/path/to/ORQIS/backend

# Transport (see src/orqis_mcp/server.py). Defaults to stdio — leave unset
# for local/Claude Desktop use. Set MCP_TRANSPORT=streamable-http to serve
# the MCP endpoint over HTTP instead (used by the mcp Docker service; see
# docker/mcp.Dockerfile and docker-compose.yml). MCP_HOST/MCP_PORT only take
# effect under streamable-http.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8001
